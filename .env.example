# Copy this file to .env and fill in your own values before running
# anything. .env is gitignored — never commit real credentials.
#
# docker-compose.yml reads this file automatically (it's in the same
# directory) for its NEO4J_AUTH substitution. graph_storage.py reads it
# too, via python-dotenv, so both sides always agree on the password —
# there's no separate place to keep them in sync.

NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-before-running
NEO4J_URI=bolt://localhost:7687
